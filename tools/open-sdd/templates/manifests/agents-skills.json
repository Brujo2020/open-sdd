{
  "version": 1,
  "artifacts": [
    {
      "id": "skills",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/agents/_shared/skills",
        "toDir": "{{AGENT_COMMANDS_DIR}}"
      },
      "when": {
        "agent": "agents-skills"
      }
    },
    {
      "id": "doc_main",
      "source": {
        "type": "templateFile",
        "from": "templates/agents/_shared/docs/AGENTS.md",
        "toDir": ".",
        "rename": "{{AGENT_DOC}}"
      },
      "when": {
        "agent": "agents-skills"
      }
    },
    {
      "id": "settings_templates",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/shared/settings/templates",
        "toDir": "{{SDD_DIR}}/settings/templates"
      },
      "when": {
        "agent": "agents-skills"
      }
    },
    {
      "id": "settings_governance",
      "source": {
        "type": "templateFile",
        "from": "templates/shared/settings/governance.json",
        "toDir": "{{SDD_DIR}}/settings"
      },
      "when": {
        "agent": "agents-skills"
      }
    },
    {
      "id": "settings_git",
      "source": {
        "type": "templateFile",
        "from": "templates/shared/settings/git.json",
        "toDir": "{{SDD_DIR}}/settings"
      },
      "when": {
        "agent": "agents-skills"
      }
    }
  ]
}
