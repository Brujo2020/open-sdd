#!/bin/sh
# open-sdd | pre-commit gate — POSIX FALLBACK (level B, "commit").
#
# THE PRIMARY GATE IS pre-commit.mjs, next to this file. The installer (scripts/install-hooks.mjs)
# copies that Node script into the hooks directory, and that is what a normal install runs. This
# shell script is kept for two reasons, and both are narrow:
#
#   1. `open-sdd floor install <target>` still copies THIS file (src/cli/commands/paper.ts). Until
#      that path is migrated it must keep working, so this template cannot be deleted.
#   2. A manual install on a host where the Node shebang cannot be honoured still gets a gate that
#      fails closed with a diagnosis instead of a silent pass. It cannot run the controls without
#      Node — the CLI is Node — so its value is the message, not the execution. That is stated here
#      so nobody mistakes this fallback for the portable path.
#
# This script is deliberately POSIX-only (/bin/sh, no arrays, no `local`, no `pipefail`): the
# previous version was bash, which made a fallback that needed the very shell it was meant to avoid.
#
# It runs the three controls whose failure is silent and whose cost is asymmetric:
#
#   C1  Triad Integrity      (advisory — never blocks; presence, not sense)
#   C2  Security Baseline    (blocking — secrets and destructive commands in the staged diff)
#   C3  Evidence Validation  (blocking when a completed task carries no captured evidence)
#
# It judges the INDEX, not the working tree: `--staged` makes the gates read what is actually
# being committed.
#
# If the CLI is missing the hook FAILS CLOSED and says how to fix it. A commit gate that silently
# degrades to "no checks" is worse than none, because the compliance report still lists it as
# running — the failure mode the reference architecture documents for level A.
#
# To relax a genuine false positive, declare it in .sdd/settings/security-allowlist.json with a
# reason. `git commit --no-verify` also bypasses this hook, but that bypass is NOT recorded — the
# allow-list is the recorded channel, and it is the one the audit can read.

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "open-sdd: no es un repositorio git; se omite el gate de commit." >&2
  exit 0
}

# Resolution order mirrors pre-commit.mjs: OPEN_SDD_CLI, then the checkout's own compiled CLI, then
# the project's node_modules (including the scoped package name the artifact ships under), then a
# global install. The bin shims (`node_modules/.bin/open-sdd`) are intentionally NOT used here: they
# are shell scripts, and handing one to Node fails with a SyntaxError instead of running the gate.
CLI=""
if [ -n "${OPEN_SDD_CLI:-}" ] && [ -f "${OPEN_SDD_CLI}" ]; then
  CLI="${OPEN_SDD_CLI}"
elif [ -f "$ROOT/tools/open-sdd/dist/cli.js" ]; then
  CLI="$ROOT/tools/open-sdd/dist/cli.js"
elif [ -f "$ROOT/node_modules/open-sdd/tools/open-sdd/dist/cli.js" ]; then
  CLI="$ROOT/node_modules/open-sdd/tools/open-sdd/dist/cli.js"
elif [ -f "$ROOT/node_modules/@brujo2020/open-sdd/tools/open-sdd/dist/cli.js" ]; then
  CLI="$ROOT/node_modules/@brujo2020/open-sdd/tools/open-sdd/dist/cli.js"
elif [ -f "$ROOT/node_modules/@brujo2020/open-sdd/dist/cli.js" ]; then
  CLI="$ROOT/node_modules/@brujo2020/open-sdd/dist/cli.js"
elif command -v open-sdd >/dev/null 2>&1; then
  CLI="$(command -v open-sdd)"
fi

if [ -z "$CLI" ]; then
  echo "" >&2
  echo "open-sdd: COMMIT BLOQUEADO — el gate de commit no puede ejecutarse." >&2
  echo "  No se encontró el CLI (level B falla cerrado: un instrumento ausente no se lee como" >&2
  echo "  verificación aprobada). Resuélvelo con una de estas opciones:" >&2
  echo "    npm run build                 # checkout del propio open-sdd" >&2
  echo "    npm install -D open-sdd        # como dependencia del proyecto" >&2
  echo "    export OPEN_SDD_CLI=/ruta/al/cli.js" >&2
  echo "  Para commitear sin el gate: git commit --no-verify  (bypass NO registrado)." >&2
  echo "" >&2
  exit 1
fi

echo "open-sdd: gates críticos sobre el índice (C1 tríada · C2 seguridad · C3 evidencia)..."

node "$CLI" gates run C1 C2 C3 --staged --strict
STATUS=$?

# Declared rigor level. Declaring a level is ACCEPTING its demands: from spec-anchored upward the
# constitution is required and its absence blocks. The check only runs when the project declares a
# level, so installing this hook into a project that has not opted in changes nothing.
if [ -f "$ROOT/.sdd/settings/rigor.json" ]; then
  echo "open-sdd: nivel de rigor declarado — comprobando la constitución y sus exigencias..."
  # `--no-drift`: at commit time the change you are committing IS the modification, so a drift
  # check against declared boundaries is tautological and would block the very act of committing.
  # Drift is enforced at the pull-request boundary (.github/workflows/gates.yml runs the full check).
  # --quiet: un commit no debería parecer una auditoría. El código de salida lleva el veredicto;
  # el detalle completo está a un `open-sdd govern rigor` de distancia.
  node "$CLI" govern rigor --no-drift --quiet
  RIGOR_STATUS=$?
  if [ "$RIGOR_STATUS" -ne 0 ]; then
    echo "" >&2
    echo "open-sdd: COMMIT BLOQUEADO por el nivel de rigor declarado." >&2
    echo "  El nivel declarado en .sdd/settings/rigor.json exige una constitución válida y los" >&2
    echo "  artefactos que ese nivel demanda (desde spec-anchored la constitución es obligatoria)." >&2
    echo "  Resuélvelo con: open-sdd brownfield constitution . --write   y revisa open-sdd govern rigor" >&2
    exit "$RIGOR_STATUS"
  fi
fi

if [ "$STATUS" -ne 0 ]; then
  echo "" >&2
  echo "open-sdd: COMMIT BLOQUEADO." >&2
  echo "  C2 bloquea ante secretos o comandos destructivos en el índice; C3 bloquea ante una" >&2
  echo "  tarea marcada como completa sin la línea _Evidence: que captura su comprobación." >&2
  echo "  Si el hallazgo es un falso positivo legítimo, decláralo con motivo en" >&2
  echo "  .sdd/settings/security-allowlist.json (registrado y reportado, no silenciado)." >&2
  exit "$STATUS"
fi

exit 0
